   "source": [
    "import numpy as np\n",
    "arr = np.array([25.5, 26.0, np.nan, 27.8, np.inf, 26.4])\n",
    "print(\"Original array:\", arr)\n",
    "print(\"\\nNAN Vaues:\", np.isnan(arr))\n",
    "print(\"INF Vaues:\", np.isinf(arr))\n",
    "\n",
    "#replace\n",
    "arr[np.isnan(arr)] = 0\n",
    "arr[np.isinf(arr)] = 0\n",
    "print(\"\\nReplaced array:\", arr)\n"
   ]
  },
